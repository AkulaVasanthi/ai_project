# GEMINI_API_KEY: Required for Gemini AI API calls on the server.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# AI_PROVIDER: "gemini" (default) or "ollama" for local LLM deployment
AI_PROVIDER="gemini"

# OLLAMA_BASE_URL & OLLAMA_MODEL: Optional local Ollama configuration when AI_PROVIDER="ollama"
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="llama3.2"

# CHROMA_URL: Optional external ChromaDB server URL; falls back to embedded SQLite vector index when unset
CHROMA_URL=""

# Optional future OAuth placeholders (not required for local upload-and-process workflows)
ZOOM_CLIENT_ID=""
ZOOM_CLIENT_SECRET=""
GOOGLE_WORKSPACE_CLIENT_ID=""
GOOGLE_WORKSPACE_CLIENT_SECRET=""
